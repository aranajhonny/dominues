# =============================================================================
# Dominues — homelab environment (copy to .env and adjust)
# =============================================================================

# --- MySQL ---
DB_DATABASE=dominues
DB_USERNAME=dominues
DB_PASSWORD=dominuespass
DB_ROOT_PASSWORD=rootpass

# --- Laravel ---
# Leave blank on first boot: the backend container generates APP_KEY automatically.
APP_KEY=

# --- Reverb (WebSocket) ---
REVERB_APP_ID=dominues-local
REVERB_APP_KEY=dominues-key
REVERB_APP_SECRET=dominues-secret

# --- CORS (portal origin; add more comma-separated if needed) ---
CORS_ALLOWED_ORIGINS=http://localhost:8080
SANCTUM_STATEFUL_DOMAINS=localhost:8080